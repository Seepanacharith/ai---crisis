# Environment Configuration for AI Crisis Companion

# Application Setup
APP_ENV=development
SECRET_KEY=super-secret-crisis-companion-jwt-key-change-in-production-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Embeddings (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/embedding-001

# Databases
# Defaults to SQLite if PostgreSQL is not running locally, can use postgresql+asyncpg://user:pass@localhost:5432/crisis_db
DATABASE_URL=sqlite+aiosqlite:///./crisis_companion.db
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./chroma_db

# Knowledge Base & Chunking
KNOWLEDGE_BASE_DIR=../knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=10
RERANK_TOP_K=4

# External Weather / Alert API (Optional)
WEATHER_API_KEY=your_weather_api_key_here

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
